            </tr>
            <tr style="border-bottom: 2px solid #e2e8f0;">
              <th style="text-align: center; padding: 0.5rem; font-size: 0.85rem; font-weight: 400;">AUPRC (%)</th>
              <th style="text-align: center; padding: 0.5rem; font-size: 0.85rem; font-weight: 400;">Avg. Acc. (%)</th>
              <th style="text-align: center; padding: 0.5rem; font-size: 0.85rem; font-weight: 400;">Sycophancy (SCR)</th>
              <th style="text-align: center; padding: 0.5rem; font-size: 0.85rem; font-weight: 400;">Survival (SCR)</th>
              <th style="text-align: center; padding: 0.5rem; font-size: 0.85rem; font-weight: 400;">LC (%)</th>
              <th style="text-align: center; padding: 0.5rem; font-size: 0.85rem; font-weight: 400;">WR (%)</th>
              <th style="text-align: center; padding: 0.5rem; font-size: 0.85rem; font-weight: 400;">SD</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom: 1px solid #e2e8f0;">
              <td style="padding: 0.5rem; white-space: nowrap;"><strong>30%</strong></td>
              <td style="text-align: center; padding: 0.5rem;">45.60±0.52</td>
              <td style="text-align: center; padding: 0.5rem;">68.64±0.59</td>
              <td style="text-align: center; padding: 0.5rem;">6.00±28.35</td>
              <td style="text-align: center; padding: 0.5rem;">21.33±18.48</td>
              <td style="text-align: center; padding: 0.5rem;">9.39</td>
              <td style="text-align: center; padding: 0.5rem;">10.19</td>
              <td style="text-align: center; padding: 0.5rem;">1.07</td>
            </tr>
