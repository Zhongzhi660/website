              <th style="text-align: center; padding: 0.35rem 0.5rem; font-weight: 600;">LLaMA-3.1-8B-Instruct</th>
              <th style="text-align: center; padding: 0.35rem 0.5rem; font-weight: 600;">GPT-4o mini</th>
              <th style="text-align: center; padding: 0.35rem 0.5rem; font-weight: 600;">差距 (Δ)</th>
            </tr>
          </thead>
          <tbody>
            <tr style="border-bottom: 1px solid #e2e8f0;">
              <td style="padding: 0.35rem 0.5rem; white-space: nowrap;"><strong>0.4</strong></td>
              <td style="text-align: center; padding: 0.35rem 0.5rem;">46.71±0.31</td>
              <td style="text-align: center; padding: 0.35rem 0.5rem;">44.86±0.84</td>
              <td style="text-align: center; padding: 0.35rem 0.5rem;">+1.85</td>
            </tr>
            <tr style="border-bottom: 1px solid #e2e8f0;">
              <td style="padding: 0.35rem 0.5rem; white-space: nowrap;"><strong>0.6</strong></td>
              <td style="text-align: center; padding: 0.35rem 0.5rem;">47.80±0.32</td>
              <td style="text-align: center; padding: 0.35rem 0.5rem;">44.88±0.78</td>
              <td style="text-align: center; padding: 0.35rem 0.5rem;">+2.92</td>
            </tr>
            <tr style="border-bottom: 1px solid #e2e8f0;">
              <td style="padding: 0.35rem 0.5rem; white-space: nowrap;"><strong>0.8</strong></td>
              <td style="text-align: center; padding: 0.35rem 0.5rem;"><strong>49.12±0.49</strong></td>
              <td style="text-align: center; padding: 0.35rem 0.5rem;">44.90±0.57</td>
              <td style="text-align: center; padding: 0.35rem 0.5rem;"><strong>+4.22</strong></td>
            </tr>
            <tr style="border-bottom: 1px solid #e2e8f0;">
              <td style="padding: 0.35rem 0.5rem; white-space: nowrap;"><strong>1.0</strong></td>
              <td style="text-align: center; padding: 0.35rem 0.5rem;">47.71±0.25</td>
              <td style="text-align: center; padding: 0.35rem 0.5rem;">45.04±0.48</td>
              <td style="text-align: center; padding: 0.35rem 0.5rem;">+2.67</td>
            </tr>
