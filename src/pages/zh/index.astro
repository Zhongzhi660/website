            <th style="text-align: center;">WR (%)</th>
            <th style="text-align: center;">SD</th>
          </tr>
        </thead>
        <tbody>
          <tr style="background: #f8f9fa;">
            <td colspan="8" style="font-weight: 600; text-align: left; padding: 0.5rem 0.75rem;">人工标注基线</td>
          </tr>
